<Window x:Class="DeskTwin.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 DeskTwin" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFFFFF">
    <StackPanel Margin="22,18,22,16">
        <TextBlock Text="分身会话还在运行，请选择怎么处理：" FontSize="13" FontWeight="SemiBold"
                   Foreground="#172033" TextWrapping="Wrap" />
        <TextBlock Text="前两项都会保留分身，随时可以重新连接；只有“结束分身”会关闭其中的程序。"
                   FontSize="11.5" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap" />

        <Button x:Name="TrayButton" Style="{StaticResource ChoiceCardButton}" Margin="0,16,0,8">
            <StackPanel>
                <TextBlock Text="挂到系统托盘" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="分身继续在后台运行，双击通知区域的图标（在 ^ 里）随时恢复窗口。"
                           FontSize="11" Foreground="#667085" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Button>

        <Button x:Name="KeepButton" Style="{StaticResource ChoiceCardButton}">
            <StackPanel>
                <TextBlock Text="退出，但保留分身" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="只关闭这个窗口并退出程序，分身会话继续在后台运行。"
                           FontSize="11" Foreground="#667085" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Button>

        <Button x:Name="EndButton" Style="{StaticResource ChoiceCardButton}">
            <StackPanel>
                <TextBlock Text="退出，并结束分身" FontSize="12.5" FontWeight="SemiBold" Foreground="#C33B4A" />
                <TextBlock Text="注销分身会话，其中的程序会全部关闭（关机或重启前请选这项）。"
                           FontSize="11" Foreground="#667085" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="88" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
