<Window x:Class="DeskTwin.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录凭据" Width="520" Height="450"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F7F8FC">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="桌面分身登录凭据" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="用于本机 Child Session 自动登录。账户格式：DOMAIN\用户名，或 MicrosoftAccount\邮箱。"
                       Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="账户" VerticalAlignment="Center" FontSize="12" />
            <TextBox x:Name="UserNameBox" Grid.Column="1" Height="35" Padding="9,0"
                     VerticalContentAlignment="Center" FontSize="13" />
            <TextBlock Grid.Row="1" Text="密码" VerticalAlignment="Center" FontSize="12" Margin="0,12,0,0" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Height="35" Padding="9,0"
                         VerticalContentAlignment="Center" FontSize="13" Margin="0,12,0,0" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="82,14,0,0">
            <CheckBox x:Name="RememberCheck" Content="记住密码" IsChecked="True" Margin="0" />
            <TextBlock x:Name="SavedHint" Text="尚未保存登录凭据。"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="3" Background="#FFF8E8" BorderBrush="#F0D9A8" BorderThickness="1"
                CornerRadius="7" Padding="13,11" Margin="0,18,0,0">
            <TextBlock FontSize="11" Foreground="#795C19" LineHeight="18"
                       Text="密码使用 Windows DPAPI 加密，只能由当前 Windows 用户解密。取消“记住密码”时不会写入磁盘，只在本次运行内存中使用。应用不会读取系统 RDP 弹窗中输入的密码。" />
        </Border>

        <Grid Grid.Row="5" Margin="0,20,0,0">
            <Button x:Name="ClearButton" Content="清除已保存密码" Style="{StaticResource DangerButton}"
                    HorizontalAlignment="Left" Margin="0" Click="OnClearClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="保存并使用" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Margin="0" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
